{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agios.metal_master.digest.v1",
  "type": "object",
  "required": [
    "schema",
    "morning",
    "approval_gate",
    "present",
    "absent",
    "lanes",
    "incomplete",
    "incidents"
  ],
  "properties": {
    "schema": {"const": "agios.metal_master.digest.v1"},
    "morning": {"type": "string"},
    "approval_gate": {
      "type": "object",
      "required": ["note", "grants"],
      "properties": {
        "note": {"type": "string"},
        "grants": {"type": "array"}
      }
    },
    "present": {"type": "array"},
    "absent": {"type": "array"},
    "lanes": {"type": "object"},
    "incomplete": {"type": "array"},
    "off_roster": {"type": "array"},
    "answered_while_absent": {"type": "array"},
    "incidents": {"type": "array"}
  }
}
